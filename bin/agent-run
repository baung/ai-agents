#!/usr/bin/env bash
# Start (or reattach to) an agent container for the current folder.
set -euo pipefail

usage() {
  cat >&2 <<EOF
Usage: $(basename "$0") [-a agent] [-m model] [-k keychain-item] [name]

  -a agent          Agent to run; uses image <agent>-box (default: claude)
  -m model          Model passed to the agent as --model (default: agent's default)
  -k keychain-item  Keychain item holding the GitHub token (default: gh-agent-token)
  name              Container name suffix (default: current folder name)

The container is named <agent>-<name> and mounts the current folder at /workspace.
If it already exists, it is started and attached; -m and -k only apply when creating it.
EOF
  exit 1
}

agent=claude
model=
key=gh-agent-token
while getopts "a:m:k:h" opt; do
  case $opt in
    a) agent=$OPTARG ;;
    m) model=$OPTARG ;;
    k) key=$OPTARG ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -le 1 ] || usage

# Docker names allow [a-zA-Z0-9_.-]
name=$(printf '%s' "${1:-$(basename "$PWD")}" | tr -c 'a-zA-Z0-9_.-' '-')
container="$agent-$name"

running=$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null || true)

if [ -n "$running" ]; then
  mounted=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' "$container")
  mounted=${mounted#/host_mnt}  # Docker Desktop prefixes host paths
  if [ "$mounted" != "$PWD" ]; then
    echo "Error: $container mounts $mounted, not $PWD." >&2
    echo "Run from $mounted, pass a different name, or recreate with: docker rm -f $container" >&2
    exit 1
  fi
  if [ -n "$model" ]; then
    echo "Warning: $container already exists; -m ignored. Recreate with: docker rm -f $container" >&2
  fi
  [ "$running" = true ] || docker start "$container" >/dev/null
else
  if ! GH_TOKEN=$(security find-generic-password -s "$key" -w 2>/dev/null); then
    echo "Keychain item '$key' not found" >&2
    exit 1
  fi
  export GH_TOKEN
  cmd=()
  [ -z "$model" ] || cmd=("$agent" --model "$model")
  docker run -dit --name "$container" \
    -v "$PWD":/workspace \
    -v "$agent-config":"/home/vscode/.$agent" \
    -e GH_TOKEN \
    "$agent-box" ${cmd[@]+"${cmd[@]}"} >/dev/null
fi

echo "Attaching to $container. Detach with Ctrl+p then Ctrl+q."
exec docker attach "$container"
